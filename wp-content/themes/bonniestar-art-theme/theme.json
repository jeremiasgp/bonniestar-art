{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "42rem", "wideSize": "76rem" },
    "custom": {
      "layout": { "gutter": "clamp(1rem, 4vw, 3rem)" },
      "header": { "anchorOffset": "9rem" }
    },
    "blocks": {
      "core/image": { "lightbox": { "enabled": true, "allowEditing": true } }
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "surface", "name": "Surface", "color": "#FFFFFA" },
        { "slug": "ink", "name": "Ink", "color": "#080705" },
        { "slug": "muted", "name": "Muted", "color": "#40434E" },
        { "slug": "accent", "name": "Accent", "color": "#912F40" },
        { "slug": "accent-strong", "name": "Accent strong", "color": "#702632" }
      ]
    },
    "spacing": {
      "units": ["rem", "%", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "name": "Small", "size": "0.5rem" },
        { "slug": "30", "name": "Medium", "size": "1rem" },
        { "slug": "40", "name": "Large", "size": "1.5rem" },
        { "slug": "50", "name": "Extra large", "size": "clamp(2rem, 5vw, 4rem)" },
        { "slug": "60", "name": "Section", "size": "clamp(3.5rem, 8vw, 7rem)" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "hyperlegible",
          "name": "Atkinson Hyperlegible",
          "fontFamily": "'Atkinson Hyperlegible', system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Atkinson Hyperlegible", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/atkinson-hyperlegible/AtkinsonHyperlegible-Regular.ttf"] },
            { "fontFamily": "Atkinson Hyperlegible", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": ["file:./assets/fonts/atkinson-hyperlegible/AtkinsonHyperlegible-Bold.ttf"] },
            { "fontFamily": "Atkinson Hyperlegible", "fontStyle": "italic", "fontWeight": "400", "fontDisplay": "swap", "src": ["file:./assets/fonts/atkinson-hyperlegible/AtkinsonHyperlegible-Italic.ttf"] },
            { "fontFamily": "Atkinson Hyperlegible", "fontStyle": "italic", "fontWeight": "700", "fontDisplay": "swap", "src": ["file:./assets/fonts/atkinson-hyperlegible/AtkinsonHyperlegible-BoldItalic.ttf"] }
          ]
        },
        { "slug": "system", "name": "System", "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "1rem", "fluid": false },
        { "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": false },
        { "slug": "large", "name": "Large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
        { "slug": "x-large", "name": "Extra large", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } },
        { "slug": "display", "name": "Display", "size": "5rem", "fluid": { "min": "2.75rem", "max": "5rem" } }
      ]
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|surface", "text": "var:preset|color|ink" },
    "spacing": {
      "blockGap": "var:preset|spacing|40",
      "padding": { "left": "var:custom|layout|gutter", "right": "var:custom|layout|gutter" }
    },
    "typography": { "fontFamily": "var:preset|font-family|hyperlegible", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.7" },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|accent" },
        ":hover": { "color": { "text": "var:preset|color|accent-strong" } }
      },
      "button": {
        "border": { "radius": "0.25rem" },
        "spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } },
        "typography": { "fontFamily": "inherit", "fontSize": "var:preset|font-size|medium", "fontWeight": "700" },
        "color": { "background": "var:preset|color|accent", "text": "var:preset|color|surface" },
        ":hover": { "color": { "background": "var:preset|color|accent-strong", "text": "var:preset|color|surface" } }
      },
      "heading": { "typography": { "fontWeight": "400", "lineHeight": "1.2" } },
      "h1": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|large" } }
    },
    "blocks": {
      "core/post-date": { "color": { "text": "var:preset|color|muted" } },
      "core/site-tagline": { "color": { "text": "var:preset|color|muted" } },
      "core/navigation": { "typography": { "fontSize": "var:preset|font-size|small" } },
      "core/site-title": { "typography": { "fontWeight": "700", "lineHeight": "1.2" }, "elements": { "link": { "color": { "text": "var:preset|color|ink" }, "typography": { "textDecoration": "none" } } } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
