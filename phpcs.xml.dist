<?xml version="1.0"?>
<ruleset name="Bonniestar Art">
  <description>WordPress standards for version-controlled custom PHP.</description>
  <file>wp-content/themes/bonniestar-art-theme</file>
  <file>wp-content/plugins/bonniestar-art-plugin</file>
  <arg name="extensions" value="php"/>
  <arg value="sp"/>
  <rule ref="WordPress"/>
  <config name="minimum_wp_version" value="7.1"/>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="bonniestar-art-theme"/>
        <element value="bonniestar-art-plugin"/>
      </property>
    </properties>
  </rule>
</ruleset>
